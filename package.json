{
  "name": "fieldsync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/server",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "db:migrate": "npm run db:migrate --workspace=@fieldsync/server",
    "test:m1": "node --test tests/m1-auth-assets.test.js",
    "test:m2": "node --test tests/m2-inspections.test.js",
    "test:m3": "node --test --test-concurrency=1 tests/m3-*.test.js",
    "test:m3:browser": "node scripts/verify-m3-browser.js",
    "test:m4": "node --test --test-concurrency=1 tests/m4-*.test.js",
    "test:m4:browser": "node scripts/verify-m4-browser.js",
    "test:m5": "node --test --test-concurrency=1 tests/m5-*.test.js",
    "test:m5:browser": "node scripts/verify-m5-browser.js",
    "test:cloudinary": "node --test --test-concurrency=1 tests/cloudinary-*.test.js",
    "test:cloudinary:browser": "node scripts/verify-cloudinary-browser.js",
    "worker": "node apps/server/src/worker.js",
    "dev": "concurrently --kill-others --names api,web --prefix-colors cyan,green \"npm run dev --workspace=@fieldsync/server\" \"npm run dev --workspace=@fieldsync/web\"",
    "infra:up": "node scripts/infra.js up",
    "infra:down": "node scripts/infra.js down",
    "infra:setup": "node scripts/setup-storage.js",
    "check:env": "node scripts/check-environment.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "build": "npm run build --workspace=@fieldsync/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "supertest": "^7.1.4"
  },
  "dependencies": {
    "@neon/config": "^1.14.3",
    "@neon/env": "^2.1.6"
  }
}
