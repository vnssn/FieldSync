# Copy to .env. These credentials are for loopback-only local development.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_PORT=5173
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=info
SESSION_TTL_HOURS=168
SERVE_WEB=false
RUN_INLINE_WORKER=false
TRUST_PROXY_HOPS=0
AUTH_RATE_LIMIT=60
AI_RATE_LIMIT=10

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=fieldsync
POSTGRES_USER=fieldsync
POSTGRES_PASSWORD=fieldsync_dev_pg_password
# Hosting can instead provide DATABASE_URL; Neon uses its pooled URL here.
# If DATABASE_URL is pooled, set DATABASE_URL_UNPOOLED (or MIGRATIONS_DATABASE_URL)
# to the matching direct URL for schema migrations.
# Keep POSTGRES_SSL=true for Neon; certificate validation stays enabled.
POSTGRES_SSL=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=fieldsync_dev_redis_password
# Hosting can instead provide REDIS_URL; use rediss:// for external verified TLS.
QUEUE_PREFIX=fieldsync-dev

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=fieldsync_local
MINIO_ROOT_PASSWORD=fieldsync_dev_minio_password
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fieldsync-dev
# Local-only credentials match MinIO. Use restricted service credentials before deployment.
S3_ACCESS_KEY_ID=fieldsync_local
S3_SECRET_ACCESS_KEY=fieldsync_dev_minio_password
S3_FORCE_PATH_STYLE=true
EVIDENCE_STORAGE_PROVIDER=s3
# Render selects cloudinary; S3_* settings are then ignored. Server/worker only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Dedicated namespace per deployment, e.g. fieldsync-production (never shared).
CLOUDINARY_FOLDER=

AI_ENABLED=false
# Optional, server/worker only. Never prefix secrets with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
AI_TIMEOUT_MS=30000
AI_MAX_PER_HOUR=20
